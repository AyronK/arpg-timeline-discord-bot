# Discord Bot Configuration
TOKEN=YOUR_BOT_TOKEN_HERE
PREFIX=YOUR_BOT_PREFIX_HERE
INVITE_LINK=YOUR_BOT_INVITE_LINK_HERE
# Optional: comma-separated user IDs that receive /feedback DMs (defaults to the app/team owner)
FEEDBACK_USER_IDS=

# aRPG API Configuration
ARPG_API_BASE=https://www.arpg-timeline.com/api
ARPG_TOKEN_URL=https://www.arpg-timeline.com/api/v1/token
ARPG_CLIENT_ID=your_arpg_client_id
ARPG_CLIENT_SECRET=your_arpg_client_secret

# Optional: top.gg token; when set, the bot posts its server count to top.gg every 30 minutes
TOPGG_TOKEN=
